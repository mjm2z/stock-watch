[Unit]
Description=StockWatch Alpaca experiment market streams
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stock-watch
Group=stock-watch
WorkingDirectory=/opt/stock-watch
EnvironmentFile=/etc/stock-watch/stock-watch.env
EnvironmentFile=-/etc/stock-watch/systems.env
ExecStart=/usr/local/bin/node services/experiment-feed.mjs
Restart=always
RestartSec=5
MemoryMax=384M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-watch

[Install]
WantedBy=multi-user.target
