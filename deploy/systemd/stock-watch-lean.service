[Unit]
Description=StockWatch independent LEAN research bridge
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=stock-watch
Group=stock-watch
WorkingDirectory=/opt/stock-watch/worker
EnvironmentFile=/etc/stock-watch/stock-watch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stock-watch/.venv/bin/python -m stock_watch_worker.lean_worker --database ${STOCK_WATCH_DATABASE_PATH}
Restart=on-failure
RestartSec=15
CPUQuota=100%
MemoryMax=512M
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-watch
[Install]
WantedBy=multi-user.target
