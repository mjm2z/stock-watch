[Unit]
Description=Stock Watch systems-stock-shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stock-watch
Group=stock-watch
WorkingDirectory=/opt/stock-watch/worker
EnvironmentFile=/etc/stock-watch/stock-watch.env
EnvironmentFile=-/etc/stock-watch/systems.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stock-watch/.venv/bin/stock-watch-systems --database ${STOCK_WATCH_DATABASE_PATH} stock-shadow
TimeoutStartSec=240
CPUQuota=100%
MemoryMax=512M
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-watch
StandardOutput=journal
StandardError=journal
