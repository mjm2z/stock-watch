[Unit]
Description=Dispatch due Stock Watch market scans
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stock-watch
Group=stock-watch
WorkingDirectory=/opt/stock-watch/worker
EnvironmentFile=/etc/stock-watch/stock-watch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stock-watch/.venv/bin/stock-watch-worker dispatch-once --database ${STOCK_WATCH_DATABASE_PATH} --strategy-id ${STOCK_WATCH_STRATEGY_ID}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-watch-dispatch
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-watch
