[Unit]
Description=Refresh Stock Watch SEC CompanyFacts cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stock-watch
Group=stock-watch
WorkingDirectory=/opt/stock-watch/worker
EnvironmentFile=/etc/stock-watch/stock-watch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stock-watch/.venv/bin/stock-watch-worker refresh-fundamentals --database ${STOCK_WATCH_DATABASE_PATH} --data-path ${STOCK_WATCH_DATA_PATH}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-watch-fundamentals
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-watch
