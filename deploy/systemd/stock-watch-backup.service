[Unit]
Description=Create a verified Stock Watch SQLite backup

[Service]
Type=oneshot
User=stock-watch
Group=stock-watch
WorkingDirectory=/opt/stock-watch/worker
EnvironmentFile=/etc/stock-watch/stock-watch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stock-watch/.venv/bin/stock-watch-worker backup --database ${STOCK_WATCH_DATABASE_PATH} --destination /var/backups/stock-watch --keep 14
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-watch-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/stock-watch
