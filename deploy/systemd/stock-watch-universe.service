[Unit]
Description=Synchronize the approved Stock Watch S&P 500 universe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stock-watch
Group=stock-watch
WorkingDirectory=/opt/stock-watch/worker
EnvironmentFile=/etc/stock-watch/stock-watch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stock-watch/.venv/bin/stock-watch-worker sync-universe --database ${STOCK_WATCH_DATABASE_PATH}
ExecStart=/opt/stock-watch/.venv/bin/stock-watch-worker refresh-assets --database ${STOCK_WATCH_DATABASE_PATH}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-watch-universe
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-watch
