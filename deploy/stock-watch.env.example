# Install as /etc/stock-watch/stock-watch.env with mode 0600.
# Never use live brokerage credentials: the worker rejects the live endpoint.
ALPACA_API_KEY_ID=replace_with_paper_key_id
ALPACA_API_SECRET_KEY=replace_with_paper_secret
SEC_USER_AGENT=Stock Watch monitored-email@example.com
STOCK_WATCH_DATABASE_PATH=/var/lib/stock-watch/stock-watch.db
STOCK_WATCH_DATA_PATH=/var/lib/stock-watch/data
# Keep the development version here until its reviewed immutable paper clone
# has been created with `stock-watch-worker promote-strategy`.
STOCK_WATCH_STRATEGY_ID=sp500-long-v0
NODE_ENV=production
