# Store only on the application host, root-owned mode 0600.
# Existing stock credentials remain in stock-watch.env.
# Create a SECOND Alpaca paper account, reset its cash to $300, then configure:
BITCOIN_ALPACA_API_KEY_ID=
BITCOIN_ALPACA_API_SECRET_KEY=
# Generate a random token of at least 32 characters. Never commit the real token.
# The web service also needs this file to enable operator sign-in.
SYSTEMS_OPERATOR_TOKEN=
