# Store only on the application host, root-owned mode 0600.
# Existing stock credentials remain in stock-watch.env.
# Use a separate Alpaca PAPER account. Never reset an established account.
# Experimental automatic setup accepts flat cash >$0 and <=$1,000; legacy manual
# initial funding expects $300. See README for allocations and cash-flow reconciliation.
BITCOIN_ALPACA_API_KEY_ID=
BITCOIN_ALPACA_API_SECRET_KEY=
# Generate a random token of at least 32 characters. Never commit the real token.
# The web service also needs this file to enable operator sign-in.
SYSTEMS_OPERATOR_TOKEN=

# One dedicated manual paper account for both stocks and Bitcoin; no fallback to
# automated credentials. StockWatch enforces separate virtual asset budgets.
MANUAL_ALPACA_API_KEY_ID=
MANUAL_ALPACA_API_SECRET_KEY=
# Two distinct random >=32-character service credentials.
STOCK_WATCH_AUTOBOT_TOKEN=
STOCK_WATCH_BROWSER_SERVICE_TOKEN=
STOCK_WATCH_TELEGRAM_USER_ID=
STOCK_WATCH_TELEGRAM_CHAT_ID=
STOCK_WATCH_DIGEST_TIME=20:00
