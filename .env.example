# AI Stock Analysis Dashboard - Environment Variables
# Copy this file to .env.local and fill in your API keys

# ===================
# MARKET DATA (Choose one or both)
# ===================

# Finnhub API Key (RECOMMENDED - Free tier friendly)
# Get your free key at: https://finnhub.io/
# Free tier: 60 API calls/minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpaca (zero-cost v1 market/news data and PAPER trading)
# Create paper credentials at https://app.alpaca.markets/
# The worker hard-rejects the live brokerage endpoint.
ALPACA_API_KEY_ID=your_alpaca_paper_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_paper_secret_key_here

# Financial Modeling Prep API Key (OPTIONAL - Requires paid plan for full access)
# Get your key at: https://financialmodelingprep.com/developer
# Note: Free tier has limited endpoint access as of Sept 2025
# FMP_API_KEY=your_fmp_api_key_here

# Set to 'true' to use FMP instead of Finnhub (requires paid FMP plan)
# USE_FMP=false

# ===================
# AI ANALYSIS (Phase 1)
# ===================

# Anthropic (Claude) API Key
# Get your key at: https://console.anthropic.com/
# Used for AI stock analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SEC EDGAR requires an identified User-Agent for automated requests.
# Use an application name and a monitored contact email.
SEC_USER_AGENT=Stock Watch your_email@example.com

# ===================
# OPTIONAL (Phase 2)
# ===================

# Supabase (for cross-device sync)
# Get your keys at: https://supabase.com/
# SUPABASE_URL=your_supabase_url_here
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===================
# DEVELOPMENT
# ===================

# Set to 'development' or 'production'
NODE_ENV=development

# Server-side worker paths (examples for a1347-j)
# STOCK_WATCH_DATABASE_PATH=/var/lib/stock-watch/stock-watch.db
# STOCK_WATCH_DATA_PATH=/var/lib/stock-watch/data
